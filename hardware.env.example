# Fill using the actual robot. Source via: set -a; . ./hardware.env; set +a
DXL_PORT=/dev/ttyUSB0
DXL_BAUD=
DXL_ID1=
DXL_ID2=
DXL_SIGN1=
DXL_SIGN2=
DXL_LIMIT=
PCA_BUS=/dev/i2c-1
PCA_ADDR=0x40
# Linux IIO/sysfs readable numeric files, absolute paths.
TOF_PATH=
TOF_MM_PER_UNIT=
ACCEL_X=
ACCEL_Y=
ACCEL_Z=
# For the 200 mm and 250 mm pipe presets, measured pulse widths in microseconds.
# CH0..3 correspond to the actual four wheels. Do NOT copy values between wheels.
WHEEL_200_CH0_US=
WHEEL_200_CH1_US=
WHEEL_200_CH2_US=
WHEEL_200_CH3_US=
WHEEL_250_CH0_US=
WHEEL_250_CH1_US=
WHEEL_250_CH2_US=
WHEEL_250_CH3_US=
